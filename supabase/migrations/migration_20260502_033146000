-- media_files
CREATE TABLE media_files (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  cdn_url text UNIQUE NOT NULL,
  file_name text NOT NULL,
  folder text NOT NULL DEFAULT '',
  uploaded_at timestamptz DEFAULT now()
);
ALTER TABLE media_files ENABLE ROW LEVEL SECURITY;
CREATE POLICY "auth_read_files" ON media_files FOR SELECT USING (auth.role() = 'authenticated');
CREATE POLICY "auth_insert_files" ON media_files FOR INSERT WITH CHECK (auth.role() = 'authenticated');

-- media_slots
CREATE TABLE media_slots (
  slot_key text PRIMARY KEY,
  cdn_url text,
  alt_text text,
  page text NOT NULL DEFAULT '',
  updated_at timestamptz DEFAULT now()
);
ALTER TABLE media_slots ENABLE ROW LEVEL SECURITY;
CREATE POLICY "public_read_slots" ON media_slots FOR SELECT USING (true);
CREATE POLICY "auth_write_slots" ON media_slots FOR ALL USING (auth.role() = 'authenticated');
